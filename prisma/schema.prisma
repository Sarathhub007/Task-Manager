

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id String @id @default(uuid())

  title       String
  description String?
  completed   Boolean @default(false)

  priority Priority  @default(MEDIUM)
  category Category?
  dueDate  DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Category {
  PERSONAL
  COLLEGE
  PLACEMENT
  WORK
}
